                  "key": "lang",
                  "value": "{{lang}}"
                }
              ]
            },
            "description": "Live validation for the registration screen. Always 200 with `{ valid, bonus_type, bonus_amount, bonus_mb, partner_name, reason }`. Only the partner’s currently active (unlocked) code is valid. Locked ladder codes return `valid: false` with `api.promo.locked`. `bonus_mb` is 0 when the promo pays Reward Dollars (`bonus_type=usd`). `email` is optional (used for first-use / fraud checks)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "List notifications",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Returns unread_count and notifications', function () {",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data).to.include.keys('unread_count', 'notifications');",
                  "});",
                  "if (json.success && json.data && json.data.notifications && json.data.notifications[0]) {",
                  "    pm.collectionVariables.set('notification_id', json.data.notifications[0].id);",
                  "    pm.environment.set('notification_id', json.data.notifications[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
